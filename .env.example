# --- Server ---
PORT=3000

# --- Firebase ---
FIREBASE_DASHBOARD_URL=https://console.firebase.google.com/project/user-747ed/analytics
ACTIVE_USERS_CARD_SELECTOR=ga-card[data-guidedhelpid="realtime"]
ACTIVE_USERS_CARD_TEXT=Active users in last 30 minutes
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
NAVIGATION_TIMEOUT=60000
CARD_WAIT_TIMEOUT=150000

# --- Google auth / browser profile ---
BROWSER_PROFILE_DIR=./browser-profile
GOOGLE_AUTH_STATE_FILE=./google-auth-state.json
BROWSER_HEADLESS=true
LOGIN_WAIT_SECONDS=180

# --- Security ---
SCREENSHOT_API_TOKEN=changeme
ADMIN_TOKEN=changeme
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
